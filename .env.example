# ============================================
# Foodie Hub - Environment Variables Template
# Copy this file to backend/.env and fill in values
# ============================================

# ---- Local PostgreSQL (or use a single DATABASE_URL) ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=restaurant_db

# ---- OR: Use a full connection string (Aiven / Render / Neon / Supabase) ----
# DATABASE_URL=postgres://user:password@host:port/database?sslmode=require
# DATABASE_SSL=true

# Server port
PORT=5000

